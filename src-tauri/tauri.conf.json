{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC Asset Manager",
  "version": "0.2.0-beta.1",
  "identifier": "com.n1cat.vrcassetmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRC Asset Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNkUxMkMwQTA4QTQwMTUKUldRVlFJcWd3Qkp1VU56Tk1aaWJRL21HcTNIZGRlYzc0US80Nk9vTEFENzJvVWRrSkc4OTFTQjUK",
      "endpoints": [
        "https://github.com/956zs/vrc-asset-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
